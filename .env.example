# Copy to .env and fill in. Never commit the real .env.

# Qoder Console > Settings > Personal Access Tokens
QODER_PAT=
QODER_API_BASE=https://api.qoder.com

# From @BotFather
TG_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave this EMPTY for first-run discovery: the bot then admits nobody but replies to
# anyone who messages it with that person's user id, so you can find your own. Once the
# list is populated, everyone not on it gets silence. An allowed user can re-read their
# own id with /start, at most once an hour.
TG_ALLOWED_IDS=

# Max concurrent live SSE connections, one per adopted conversation. Conversations beyond
# this still work, they just poll instead of streaming. Raise it if you run more chats; each
# held-open connection costs battery and a socket on a phone.
MAX_LIVE_STREAMS=4

# Monthly credit budget per user. Warns at 80%, never blocks a turn.
CREDIT_BUDGET=1000

# Reasoning effort seeded into each new user: none, low, medium, high, xhigh or max.
# Leave EMPTY to let every model use its own default_effort — note that ten of the eighteen
# current models default to max, xhigh or high, the expensive end. Only ever applied to a model
# that advertises the level; the rest ignore it, because the API rejects an effort a model does
# not list. Users override their own with /effort.
TGAGENT_EFFORT=
