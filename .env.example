# Copy to .env and fill in. Never commit the real .env.
#
# Every variable the bot reads is listed here, each at the value it defaults to, so this file
# stays a complete picture of the configuration. Only QODER_PAT and TG_BOT_TOKEN are required;
# deleting or blanking any other line leaves its default in force. A key present with nothing
# after its '=' is treated as unset, not as an empty value — config._env is what makes that so,
# and without it a blank MAX_LIVE_STREAMS would abort startup on int('').
#
# A real environment variable always beats this file, so Termux can override without editing it.

# --- Required -------------------------------------------------------------------------

# Qoder Console > Settings > Personal Access Tokens. Bills real credits.
# This is the BOOTSTRAP token: it gets the bot online the first time. Once the administrator
# rotates it from Telegram with /setpat, the new token is stored in the database and overrides
# this value on every later boot — so you do not have to edit this line to rotate, and an edit
# here is ignored once a runtime token exists.
QODER_PAT=

# From @BotFather. Anyone holding this token can impersonate the bot.
TG_BOT_TOKEN=

# --- Access ---------------------------------------------------------------------------

# The single administrator's Telegram user id. This is the root of trust: only this user can
# run /allow, /disallow, /allowed and /setpat, and only this user can rotate the API token or
# change who may use the bot. It is fixed here on purpose and CANNOT be changed at runtime, so
# a compromised chat session cannot hand an attacker the keys. Telegram offers no way to detect
# who owns a bot, so you name your own id. The admin is always allowed, listed below or not.
# Leave EMPTY for no administrator (then access is managed only by editing TG_ALLOWED_IDS).
# Find your id by messaging the bot /start.
TG_ADMIN_ID=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave this EMPTY for first-run discovery: the bot then admits nobody but the admin, and
# replies to anyone who messages it with that person's user id, so you can find your own. Once
# the list is populated, everyone not on it is told so ONCE A MINUTE and given their own id to
# pass on to you — the reply is throttled per user so a stranger cannot make the bot burn
# its Telegram send budget by spamming it. An allowed user can re-read their own id with
# /start, at most once an hour.
# This is the SEED list. Once the administrator uses /allow or /disallow, the database copy
# becomes authoritative and overrides this line on later boots, so a removal survives a restart.
TG_ALLOWED_IDS=

# --- Qoder ----------------------------------------------------------------------------

QODER_API_BASE=https://api.qoder.com

# Model seeded into each new user. /model lists what this account offers, with prices.
# Left EMPTY by default so the bot uses config.DEFAULT_MODEL and picks up a change there;
# catalog ids do drift — README section 10 records two that were renamed after Phase 0 — and
# a name pinned here would outlive the rename.
TGAGENT_MODEL=

# Reasoning effort seeded into each new user: none, low, medium, high, xhigh or max.
# Leave EMPTY to let every model use its own default_effort — note that ten of the eighteen
# current models default to max, xhigh or high, the expensive end. Only ever applied to a model
# that advertises the level; the rest ignore it, because the API rejects an effort a model does
# not list. Users override their own with /effort. An unrecognised word is a startup error,
# not a silent no-op, so a typo cannot leave you paying for `max` while believing you set `low`.
TGAGENT_EFFORT=

# --- Behaviour ------------------------------------------------------------------------

# Max concurrent live SSE connections, one per adopted conversation. Conversations beyond
# this still work, they just poll instead of streaming. Raise it if you run more chats; each
# held-open connection costs battery and a socket on a phone.
MAX_LIVE_STREAMS=4

# Monthly credit budget per user. Warns at 80%, never blocks a turn. Set 0 for no cap.
CREDIT_BUDGET=1000

# Seconds of quiet after your last message before a turn is dispatched, so typing three quick
# lines costs one billable round-trip instead of three and the agent sees one coherent thought
# rather than answering each fragment in isolation. Set 0 to send every message on its own.
BURST_DEBOUNCE_S=6.0

# DEBUG, INFO, WARNING or ERROR. DEBUG adds the SSE reconnect and pagination detail; it is
# verbose enough to rotate the log quickly, so leave it at INFO unless diagnosing something.
TGAGENT_LOG=INFO

# --- Storage --------------------------------------------------------------------------
# Both default to a path beside the project, next to the database. Uncomment only to move
# them: an absolute path is what survives a changed working directory.

# SQLite database — every conversation transcript, the credit ledger and the durable inbound
# queue. This is what lets the bot reconcile after Android kills it, so it must not live in
# scratch space. Default: <project>/tgagent.db
#TGAGENT_DB=/data/data/com.termux/files/home/tgagent.db

# Retained copies of files that crossed a conversation, so they can be re-uploaded to a new
# account when a conversation is resumed weeks later. Deliberately NOT under TMPDIR: the OS
# clears /tmp and a phone reboot wipes it. Default: <project>/filecache
#TGAGENT_FILECACHE=/data/data/com.termux/files/home/tgagent-filecache
